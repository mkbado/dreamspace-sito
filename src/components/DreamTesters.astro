---
// Tutti i Dream-tester, con i giochi che hanno provato
import type { Lang } from '../i18n/ui';
import { games, rpgs, settings, oneshots, itemTitle } from '../data/catalog';
import { itemPath } from '../data/paths';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const all = [...games, ...rpgs, ...settings, ...oneshots].filter((x) => x.playtest?.testers?.length);
const people = new Map<string, typeof all>();
for (const g of all) for (const n of g.playtest!.testers) people.set(n, [...(people.get(n) || []), g]);
const list = [...people.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
const hue = (s: string) => [...s].reduce((a, c) => a + c.charCodeAt(0) * 37, 0) % 360;
---
{list.length > 0 && (
  <section class="dt" id="dream-tester">
    <div class="container stack" style="gap: 24px;">
      <p class="label" style="margin: 0; color: var(--teal);">{L('Grazie!', 'Thank you!')}</p>
      <h2 class="pixel" style="font-size: clamp(32px, 4vw, 44px);">{L('I Dream-tester', 'The Dream-testers')}</h2>
      <p style="margin: 0; max-width: 640px; font-size: 19px;">{L('Amici e giocatori che si sono seduti al tavolo quando i giochi erano ancora prototipi. Ogni partita ci ha insegnato qualcosa.', 'Friends and players who sat down at the table while the games were still prototypes. Every session taught us something.')}</p>
      <ul class="dt__grid">
        {list.map(([n, gs]) => (
          <li class="dt__card" style={`--h:${hue(n)}`}>
            <i aria-hidden="true">{n[0]}</i>
            <b>{n}</b>
            <span class="dt__badge">{gs.length > 1 ? L(`${gs.length} giochi provati`, `${gs.length} games tested`) : L('1 gioco provato', '1 game tested')}</span>
            <span class="dt__games">{gs.map((g, i) => <>{i > 0 && ' · '}<a href={itemPath(lang, g)}>{itemTitle(lang, g)}</a></>)}</span>
          </li>
        ))}
      </ul>
      <p style="margin: 0; color: var(--soft);">{L('…e molti altri che hanno provato Dreamspace al tavolo.', '…and many more who have played Dreamspace at the table.')}</p>
    </div>
  </section>
)}
