---
// Fondale di Meriggio: un mosaico di tessere verde petrolio con un sole che le scalda dall'alto,
// raggi che girano piano, tessere d'oro che luccicano e polline che sale.
// Dove passi o clicchi, le tessere prendono la luce.
---
<canvas id="ds-mosaic" aria-hidden="true"></canvas>
<script is:inline>
(function () {
  var cv = document.getElementById('ds-mosaic'); if (!cv) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { cv.remove(); return; }
  var ctx = cv.getContext('2d'), base = document.createElement('canvas'), bx = base.getContext('2d');
  var W, H, T = 15, tiles = [], glints = [], motes = [], t0 = performance.now();
  var TEAL = ['#1a3431', '#1d3936', '#203d3a', '#1b3735', '#234440', '#19322f'];
  var WARM = ['#3d4a2a', '#4a4a26', '#56502a', '#6b5424'];
  function rnd(a) { return a[(Math.random() * a.length) | 0]; }
  function build() {
    W = cv.width = base.width = innerWidth; H = cv.height = base.height = innerHeight;
    tiles = [];
    bx.fillStyle = '#101c1a'; bx.fillRect(0, 0, W, H);
    var sx = W / 2, sy = -H * 0.35;
    for (var r = 0, y = 0; y < H + T; r++, y += T) {
      var off = (r % 2) * (T / 2);
      for (var x = -off; x < W + T; ) {
        var w = T - 1 + ((Math.random() * 5) | 0) - 2;
        var a = Math.atan2(y - sy, x - sx), d = Math.hypot(x - sx, y - sy);
        var ray = Math.sin(a * 22) > 0.6 && d < H * 1.3;
        var c = ray && Math.random() < 0.55 ? rnd(WARM) : rnd(TEAL);
        bx.fillStyle = c; bx.fillRect(x + 1, y + 1, w - 2, T - 2);
        tiles.push(x + 1, y + 1, w - 2);
        x += w;
      }
    }
  }
  build();
  var rt; addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(build, 150); });
  function glint(x, y, big) {
    var gx = Math.floor(x / T) * T, gy = Math.floor(y / T) * T;
    glints.push({ x: gx + 1, y: gy + 1, w: T - 2, life: 0, max: big ? 70 : 90 + Math.random() * 80, c: Math.random() < 0.7 ? '#f3c04f' : '#e8a23a' });
  }
  for (var i = 0; i < 26; i++) motes.push({ x: Math.random() * innerWidth, y: Math.random() * innerHeight, v: 0.15 + Math.random() * 0.3, a: Math.random() * 6, s: 1.5 + Math.random() * 2 });
  var lastMove = 0;
  addEventListener('pointermove', function (e) { var n = performance.now(); if (n - lastMove < 60) return; lastMove = n; glint(e.clientX + (Math.random() - .5) * 40, e.clientY + (Math.random() - .5) * 40, true); });
  addEventListener('pointerdown', function (e) {
    for (var k = 0; k < 18; k++) { var a = k / 18 * Math.PI * 2, rr = 20 + Math.random() * 50; glint(e.clientX + Math.cos(a) * rr, e.clientY + Math.sin(a) * rr, true); }
  });
  function frame(now) {
    var t = (now - t0) / 1000;
    ctx.drawImage(base, 0, 0);
    // raggi del sole che girano piano
    var sx = W / 2, sy = -H * 0.35, R = Math.hypot(W, H) * 1.4;
    ctx.save(); ctx.globalCompositeOperation = 'lighter';
    for (var k = 0; k < 14; k++) {
      var a0 = k / 14 * Math.PI + Math.sin(t * 0.05) * 0.25 + t * 0.012, a1 = a0 + 0.07;
      var g = ctx.createRadialGradient(sx, sy, 0, sx, sy, R);
      g.addColorStop(0, 'rgba(243,192,79,0.10)'); g.addColorStop(0.6, 'rgba(232,162,58,0.04)'); g.addColorStop(1, 'rgba(232,162,58,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(sx + Math.cos(a0) * R, sy + Math.sin(a0) * R); ctx.lineTo(sx + Math.cos(a1) * R, sy + Math.sin(a1) * R); ctx.closePath(); ctx.fill();
    }
    var pulse = 0.10 + Math.sin(t * 0.6) * 0.03;
    var sun = ctx.createRadialGradient(sx, 0, 0, sx, 0, H * 0.7);
    sun.addColorStop(0, 'rgba(243,192,79,' + pulse + ')'); sun.addColorStop(1, 'rgba(243,192,79,0)');
    ctx.fillStyle = sun; ctx.fillRect(0, 0, W, H * 0.7);
    ctx.restore();
    // tessere che luccicano
    if (Math.random() < 0.35) glint(Math.random() * W, Math.random() * H, false);
    for (var i = glints.length - 1; i >= 0; i--) {
      var q = glints[i]; q.life++;
      var p = q.life / q.max, o = p < 0.3 ? p / 0.3 : 1 - (p - 0.3) / 0.7;
      ctx.globalAlpha = Math.max(0, o) * 0.85; ctx.fillStyle = q.c; ctx.fillRect(q.x, q.y, q.w, T - 2);
      ctx.globalAlpha = Math.max(0, o) * 0.6; ctx.fillStyle = '#fff2c4'; ctx.fillRect(q.x + 2, q.y + 2, 3, 3);
      if (q.life >= q.max) glints.splice(i, 1);
    }
    // polline d'oro
    for (var m = 0; m < motes.length; m++) {
      var d = motes[m]; d.y -= d.v; d.a += 0.01; var x = d.x + Math.sin(d.a) * 12;
      if (d.y < -10) { d.y = H + 10; d.x = Math.random() * W; }
      ctx.globalAlpha = 0.45 + Math.sin(d.a * 3) * 0.2; ctx.fillStyle = '#f3c04f'; ctx.fillRect(x, d.y, d.s, d.s);
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
