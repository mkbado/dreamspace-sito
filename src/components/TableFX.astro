---
// Fondale per Intolleranti: cibo e bevande a pixel che galleggiano piano sulla tovaglia
// e briciole o schizzi di sugo dove clicchi.
---
<canvas id="ds-table" aria-hidden="true"></canvas>
<script is:inline>
(function () {
  var cv = document.getElementById('ds-table'); if (!cv) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var ctx = cv.getContext('2d'), W, H, P = 4;
  function size() { W = cv.width = Math.ceil(innerWidth / P); H = cv.height = Math.ceil(innerHeight / P); }
  size(); addEventListener('resize', size);
  // sprite: ogni lettera è un colore
  var C = { k: '#2a1216', w: '#fff4dc', y: '#f2c230', o: '#f28c28', r: '#d9452b', g: '#7bb661', b: '#8a5a2b', p: '#f3a6b8', c: '#9fe3e6', m: '#c98b4f' };
  var S = [
    ['..kkkk..', '.kwwwwk.', 'kwwyywwk', 'kwyyyywk', 'kwwyywwk', '.kwwwwk.', '..kkkk..'],                 // uovo
    ['kkkkkkkk', 'kyryyryk', '.kyyyyk.', '.kyryk..', '..kyyk..', '..kyk...', '...k....'],                 // pizza
    ['.kwwwwk.', '.kccccck', '.koooook', '.koooook', '.koooook', '.koooook', '.kkkkkk.'],                 // bibita
    ['.kkkkk..', 'kbbbbbk.', 'kgggggk.', 'krrrrrk.', 'kmmmmmk.', '.kkkkk..'],                             // panino
    ['..kk....', '.kppk...', 'kppppk..', 'kwwwwk..', '.kwwk...', '.kmmk...', '.kkkk...'],                 // dolcetto
    ['.k...k..', '.kr.rk..', '..krk...', '...k....', '...k....', '..kkk...']                               // bicchiere di vino
  ];
  var items = [];
  function add(y) { items.push({ s: S[(Math.random() * S.length) | 0], x: Math.random() * W, y: y, v: 0.05 + Math.random() * 0.08, a: Math.random() * 6, o: 0.25 + Math.random() * 0.2 }); }
  for (var i = 0; i < 14; i++) add(Math.random() * H);
  var crumbs = [];
  function draw(sp, x, y, o) {
    ctx.globalAlpha = o;
    for (var r = 0; r < sp.length; r++) for (var c = 0; c < sp[r].length; c++) { var ch = sp[r][c]; if (ch === '.') continue; ctx.fillStyle = C[ch]; ctx.fillRect(Math.round(x) + c, Math.round(y) + r, 1, 1); }
    ctx.globalAlpha = 1;
  }
  function frame() {
    ctx.clearRect(0, 0, W, H);
    for (var i = items.length - 1; i >= 0; i--) {
      var it = items[i]; it.y -= it.v; it.a += 0.01;
      if (it.y < -10) { items.splice(i, 1); add(H + 4); continue; }
      draw(it.s, it.x + Math.sin(it.a) * 3, it.y, it.o);
    }
    for (var j = crumbs.length - 1; j >= 0; j--) {
      var d = crumbs[j]; d.x += d.vx; d.y += d.vy; d.vy += 0.08; d.l -= 0.03;
      if (d.l <= 0) { crumbs.splice(j, 1); continue; }
      ctx.globalAlpha = d.l; ctx.fillStyle = d.c; ctx.fillRect(Math.round(d.x), Math.round(d.y), 1, 1); ctx.globalAlpha = 1;
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  document.addEventListener('click', function (e) {
    var cols = Math.random() < 0.5 ? ['#d9452b', '#f28c28', '#fff4dc'] : ['#c98b4f', '#f2c230', '#8a5a2b'];
    for (var k = 0; k < 12; k++) { var a = Math.random() * Math.PI * 2, s = 0.4 + Math.random() * 0.9; crumbs.push({ x: e.clientX / P, y: e.clientY / P, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 0.6, l: 1, c: cols[k % 3] }); }
  });
})();
</script>
