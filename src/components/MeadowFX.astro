---
// Cielo di Meriggio: nuvole a pixel che scorrono, soffioni e foglie che volano,
// e petali che saltano fuori dove clicchi.
---
<canvas id="ds-meadow" aria-hidden="true"></canvas>
<script is:inline>
(function () {
  var cv = document.getElementById('ds-meadow'); if (!cv) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var ctx = cv.getContext('2d'), W, H, P = 4;
  function size() { W = cv.width = Math.ceil(innerWidth / P); H = cv.height = Math.ceil(innerHeight / P); }
  size(); addEventListener('resize', size);
  var CLOUD = ['....xxxx......', '..xxxxxxxx.....', '.xxxxxxxxxxxx..', 'xxxxxxxxxxxxxxx', '.xxxxxxxxxxxxx.'];
  var clouds = [], seeds = [], petals = [];
  for (var i = 0; i < 5; i++) clouds.push({ x: Math.random() * W, y: 4 + Math.random() * H * 0.35, v: 0.02 + Math.random() * 0.03, s: 1 + (Math.random() * 2 | 0) });
  function seed(x, y) { var leaf = Math.random() < 0.35; seeds.push({ x: x, y: y, vx: 0.08 + Math.random() * 0.12, vy: -0.02 + Math.random() * 0.06, a: Math.random() * 6, leaf: leaf, c: leaf ? ['#8a9a4b', '#e9a93b', '#b8862b'][(Math.random() * 3) | 0] : '#fff8e6' }); }
  for (var j = 0; j < 22; j++) seed(Math.random() * W, Math.random() * H);
  function frame() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(255,248,230,.55)';
    clouds.forEach(function (c) {
      c.x += c.v; if (c.x > W + 40) { c.x = -40; c.y = 4 + Math.random() * H * 0.35; }
      for (var r = 0; r < CLOUD.length; r++) for (var q = 0; q < CLOUD[r].length; q++) if (CLOUD[r][q] === 'x') ctx.fillRect(Math.round(c.x) + q * c.s, Math.round(c.y) + r * c.s, c.s, c.s);
    });
    for (var i = seeds.length - 1; i >= 0; i--) {
      var s = seeds[i]; s.a += 0.03; s.x += s.vx + Math.sin(s.a) * 0.05; s.y += s.vy + Math.cos(s.a * 0.7) * 0.06;
      if (s.x > W + 4 || s.y > H + 4 || s.y < -4) { seeds.splice(i, 1); seed(-3, Math.random() * H); continue; }
      var x = Math.round(s.x), y = Math.round(s.y);
      ctx.fillStyle = s.c; ctx.globalAlpha = 0.85;
      if (s.leaf) { ctx.fillRect(x, y, 2, 1); ctx.fillRect(x + 1, y + 1, 2, 1); }
      else { ctx.fillRect(x, y, 1, 1); ctx.fillRect(x - 1, y - 1, 1, 1); ctx.fillRect(x + 1, y - 1, 1, 1); ctx.fillStyle = '#b8a27a'; ctx.fillRect(x, y + 1, 1, 2); }
      ctx.globalAlpha = 1;
    }
    for (var k = petals.length - 1; k >= 0; k--) {
      var p = petals[k]; p.x += p.vx; p.y += p.vy; p.vy += 0.03; p.vx *= 0.98; p.l -= 0.015;
      if (p.l <= 0) { petals.splice(k, 1); continue; }
      ctx.globalAlpha = Math.min(1, p.l * 2); ctx.fillStyle = p.c; ctx.fillRect(Math.round(p.x), Math.round(p.y), p.z, p.z); ctx.globalAlpha = 1;
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  document.addEventListener('click', function (e) {
    var cols = ['#fff8e6', '#f5c14b', '#e98a9a', '#ffffff'];
    for (var n = 0; n < 14; n++) { var a = Math.random() * Math.PI * 2, v = 0.3 + Math.random() * 0.8; petals.push({ x: e.clientX / P, y: e.clientY / P, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 0.7, l: 1, z: 1 + (n % 3 === 0 ? 1 : 0), c: cols[n % 4] }); }
  });
})();
</script>
