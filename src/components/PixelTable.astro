---
interface Props { label: string }
const { label } = Astro.props;
const shirts = ['#3FA34D', '#F2C230', '#5BB8F0', '#D9442B', '#F28C28', '#EE7FB0', '#8A5CD8', '#FFFFFF'];
const xs = [3, 10, 17, 24, 34, 41, 48, 55];
---
<svg viewBox="0 0 64 40" preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges" role="img" aria-label={label}>
  <rect width="64" height="40" fill="#FFE9C2" />
  {xs.map((x, i) => (
    <>
      <rect x={x + 1} y="10" width="4" height="4" fill="#F2C9A0" />
      <rect x={x} y="14" width="6" height="8" fill={shirts[i]} />
      <rect x={x + 2} y="11" width="1" height="1" fill="#12163A" />
    </>
  ))}
  <rect x="0" y="20" width="64" height="5" fill="#8B5A2B" />
  <rect x="0" y="25" width="64" height="2" fill="#6B4220" />
  <rect x="4" y="19" width="5" height="1" fill="#FFFFFF" /><rect x="18" y="19" width="5" height="1" fill="#FFFFFF" />
  <rect x="35" y="19" width="5" height="1" fill="#FFFFFF" /><rect x="49" y="19" width="5" height="1" fill="#FFFFFF" />
  <rect x="30" y="16" width="4" height="4" fill="#D9442B" /><rect x="31" y="15" width="2" height="1" fill="#FFFFFF" />
  <rect x="4" y="27" width="2" height="13" fill="#6B4220" /><rect x="58" y="27" width="2" height="13" fill="#6B4220" />
</svg>
