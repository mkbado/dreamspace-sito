---
// Schede tecniche dei Dreamspacer: scena, statistiche per livello, equipaggiamento e abilità
import type { Character } from '../data/catalog';
import type { Lang } from '../i18n/ui';
import { statKeys, statLabel, typeLabel, withIcons, statIcon, typeIcon, slugOf } from './dreamspacer';
interface Props { lang: Lang; list: Character[] }
const { lang, list } = Astro.props;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
---
<div class="ds-grid">
  {list.map((c) => {
    const lv = c.levels!;
    const l1 = lv[0], l2 = lv[1];
    const id = `ds-${slugOf(c.name)}`;
    return (
      <article class="ds-sheet" id={id} data-lv="1" style={`--c: ${c.color}; --ink: ${c.ink};`}>
        <div class="ds-sheet__scene" style={c.scene ? `background-image: url(${c.scene});` : ''}>
          <img class="ds-sheet__sprite" src={c.image} alt={c.alt[lang]} loading="lazy" />
          {c.planet && <span class="ds-sheet__planet">{L('Pianeta', 'Planet')} · {c.planet[lang]}</span>}
        </div>
        <header class="ds-sheet__name">
          <h3>{c.name}</h3>
          <p>{c.role?.[lang]}{c.focus && <> · {c.focus[lang]}</>}</p>
        </header>
        <div class="ds-sheet__body">
          {l2 && (
            <div class="ds-lv" role="group" aria-label={L('Livello', 'Level')}>
              <button type="button" data-set="1" aria-pressed="true">LV 1</button>
              <button type="button" data-set="2" aria-pressed="false">LV 2</button>
            </div>
          )}
          <ul class="ds-stats">
            {statKeys.map((k) => {
              const a = l1.stats[k], b = l2 ? l2.stats[k] : a;
              return (
                <li>
                  <img src={statIcon(k)} alt="" width="28" height="28" />
                  <b><span class="v1">{a}</span>{l2 && <span class={`v2${b > a ? ' up' : ''}`}>{b}</span>}</b>
                  <span class="lbl">{statLabel[k][lang]}</span>
                </li>
              );
            })}
          </ul>

          {c.equip && (
            <div class="ds-equip">
              <p class="ds-kicker"><img src={typeIcon(c.equip.type)} alt="" width="18" height="18" />{L('Equipaggiamento iniziale', 'Starting equip')}{c.equip.type && c.equip.type !== 'equip' && <> · {typeLabel[c.equip.type]?.[lang]}</>}</p>
              <div class="ds-equip__row">
                {c.equip.icon && <img class="ds-equip__icon" src={c.equip.icon} alt="" width="64" height="64" loading="lazy" />}
                <div>
                  <h4>{c.equip.name[lang]}{c.equip.cost && <span class="ds-cost" set:html={withIcons(c.equip.cost, lang)} />}</h4>
                  <p set:html={withIcons(c.equip.text[lang], lang)} />
                </div>
              </div>
            </div>
          )}

          <div class="ds-abil">
            <p class="ds-kicker">{L('Abilità', 'Abilities')}</p>
            {lv.map((level, i) => level.abilities.map((a) => (
              <div class={`ds-ab${i > 0 ? ' lv2only' : ''}`}>
                <h4>
                  {a.name}
                  {i > 0 && <span class="ds-new">LV 2</span>}
                  {a.passive ? <span class="ds-cost ds-cost--passive">{L('Passiva', 'Passive')}</span> : a.cost && <span class="ds-cost" set:html={withIcons(a.cost, lang)} />}
                </h4>
                <p set:html={withIcons(a.text[lang], lang)} />
              </div>
            )))}
          </div>

          {c.bio[lang] && <details class="ds-bio"><summary>{L('Chi è', 'Who they are')}</summary><p>{c.bio[lang]}</p></details>}
        </div>
      </article>
    );
  })}
</div>

<script is:inline>
  document.querySelectorAll('.ds-sheet .ds-lv').forEach((g) => {
    const card = g.closest('.ds-sheet');
    g.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-set]');
      if (!b) return;
      card.dataset.lv = b.dataset.set;
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    });
  });
</script>
