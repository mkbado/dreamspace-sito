---
// Pagina di Meriggio: stile a mosaico, tessere d’ocra, verde petrolio e oro.
import Base from '../layouts/Base.astro';
import Quotes from './Quotes.astro';
import Playtest from './Playtest.astro';
import MosaicFX from './MosaicFX.astro';
import { t, sections, type Lang } from '../i18n/ui';
import { site, tl, type Setting, novelFor, chapterOut, chapterOnline, chapterWindow } from '../data/catalog';
import { chapterPath, novelPath } from '../data/paths';

interface Props { lang: Lang; s: Setting; altPath: string }
const { lang, s, altPath } = Astro.props;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const novelBook = s.books.find((b) => b.n === '❦');
const gameBooks = s.books.filter((b) => b.n !== '❦');
const roman = ['I', 'II', 'III', 'IV', 'V'];
const nv = novelFor(s.slug);
const chapters = nv?.chapters ?? [];
const chHref = (c) => (chapterOnline(c, lang) ? chapterPath(lang, nv!, c) : c.pdf?.[lang]);
const outCount = chapters.filter((c) => chapterOut(c, lang)).length;
const firstOut = chapters.find((c) => chapterOut(c, lang));
const nextIdx = chapters.findIndex((c) => !chapterOut(c, lang));
const win = chapterWindow(chapters, lang);
const places = s.atlas.places ?? [];
---
<Base lang={lang} title={s.title} description={s.short[lang]} altPath={altPath} bodyClass="skin-fiaba" extraFonts>
  <MosaicFX />
  <!-- Copertina -->
  <section class="fb-cover">
    <div class="container" style="padding-top: 22px;">
      <nav class="crumbs fb-crumbs" aria-label={L('Percorso', 'Breadcrumb')}><a href={`/${lang}/`}>{t(lang, 'crumb.home')}</a> › <a href={`/${lang}/${sections[lang].rpg}/`}>{t(lang, 'nav.rpg')}</a> › {s.title}</nav>
    </div>
    <div class="container mg-hero">
    <figure class="mg-hero__cover">
      <img src={s.banner} width="768" height="1152" alt={s.bannerAlt[lang]} fetchpriority="high" />
    </figure>
    <div class="fb-cover__body mg-hero__body">
      <h1 class="sr-only">{s.title}</h1>
      <p class="fb-kicker">{L('C’era una volta, in una valle sempre al sole…', 'Once upon a time, in a valley always in the sun…')}</p>
      <p class="fb-tagline">{s.tagline[lang]}</p>
      <span class="fb-divider" aria-hidden="true"></span>
      <nav class="fb-paths" aria-label={L('Cosa trovi in Meriggio', 'What you’ll find in Meriggio')}>
        <a href="#libri" class="fb-path">
          <span class="fb-path__icon" aria-hidden="true">📜</span>
          <strong>{L('I libri del gioco', 'The game books')}</strong>
          <span>{L('Guida al mondo, avventura e bestiario per chi narra', 'World guide, adventure and bestiary for the storyteller')}</span>
        </a>
        {s.novel && (
          <a href="#romanzo" class="fb-path">
            <span class="fb-path__icon" aria-hidden="true">❦</span>
            <strong>{L('Il romanzo a puntate', 'The serial novel')}</strong>
            <span>{tl(lang, s.novelTitle, s.novelTitleEn)} · {L('un capitolo alla volta', 'one chapter at a time')}</span>
          </a>
        )}
        <a href="#compagnia" class="fb-path">
          <span class="fb-path__icon" aria-hidden="true">✦</span>
          <strong>{L('La valle e i suoi eroi', 'The valley and its heroes')}</strong>
          <span>{L('Personaggi, luoghi, genti e creature', 'Characters, places, peoples and creatures')}</span>
        </a>
      </nav>
    </div>
    </div>
  </section>

  <!-- Presentazione -->
  <section class="container fb-intro">
    <div class="stack" style="gap: 18px; flex: 1 1 540px; min-width: 0;">
      <p class="fb-label">{s.tag[lang]}</p>
      {s.intro[lang].map((p, i) => <p class={i === 0 ? 'fb-lead fb-dropcap' : 'fb-body'}>{p}</p>)}
    </div>
    <aside class="stack" style="flex: 1 1 320px; min-width: 0; gap: 22px;">
      <div class="fb-scroll">
        <p class="fb-label" style="text-align: center;">{t(lang, 'rpg.sheet')}</p>
        <dl>
          {s.sheet.map((x) => (<><dt>{x.label[lang]}</dt><dd>{x.value[lang]}</dd></>))}
        </dl>
      </div>
      <blockquote class="fb-motto">
        <p>«{s.motto[lang]}»</p>
        <footer>{L('La regola d’oro per raccontare Meriggio', 'The golden rule for telling Meriggio')}</footer>
      </blockquote>
    </aside>
  </section>

  <!-- Libri del gioco -->
  <section id="libri" class="fb-band fb-band--meadow">
    <div class="container stack" style="gap: 40px;">
      <div class="fb-head">
        <p class="fb-kicker">{L('Per chi narra · la biblioteca della valle', 'For the storyteller · the valley library')}</p>
        <h2 class="fb-h2">{L('I libri del gioco', 'The game books')}</h2>
        <p class="fb-body" style="max-width: 640px;">{L('Tutto il necessario per giocare Meriggio con la 5ª edizione: il mondo, la prima avventura e le creature che la abitano.', 'Everything you need to play Meriggio with 5th edition: the world, the first adventure and the creatures that live in it.')}</p>
      </div>
      <div class="fb-books">
        {gameBooks.map((b, i) => {
          const f = b.file?.[lang] || b.file?.it;
          return (
            <article class={`fb-book fb-book--${i % 4}`}>
              {b.cover && <div class="fb-book__cover"><img src={b.cover} alt="" loading="lazy" width="640" height="640" /><span class="fb-book__seal">{roman[i] ?? b.n}</span></div>}
              <div class="fb-book__body">
                <p class="fb-label">{L('Libro', 'Book')} {roman[i] ?? b.n}</p>
                <h3>{b.title[lang]}</h3>
                <p>{b.text[lang]}</p>
                {f
                  ? <a href={f} class="fb-book__dl" download={f.startsWith('#') ? undefined : ''}>{b.action[lang]}</a>
                  : <span class="fb-book__dl fb-book__dl--soon">{b.action[lang]} · {L('in arrivo', 'coming soon')}</span>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Romanzo a puntate -->
  {s.novel && (
    <section id="romanzo" class="fb-band fb-band--dusk">
      <div class="container stack" style="gap: 48px;">
        <div class="fb-novel-head">
          <div class="fb-novel-cover">
            <img src={novelBook?.cover || s.image} alt={L(`La copertina di ${tl(lang, s.novelTitle, s.novelTitleEn)}: i cinque protagonisti, di spalle, guardano la valle di Meriggio sotto il sole`, `The cover of ${tl(lang, s.novelTitle, s.novelTitleEn)}: the five heroes, seen from behind, look out over the valley of Meriggio under the sun`)} loading="lazy" width="768" height="1152" />
          </div>
          <div class="stack" style="flex: 1 1 380px; min-width: 0; gap: 16px;">
            <p class="fb-kicker">{s.novel.kicker[lang]}</p>
            <h2 class="fb-h2">{tl(lang, s.novelTitle, s.novelTitleEn)}</h2>
            <p class="fb-body">{s.novel.text[lang]}</p>
            <div class="fb-progress" role="img" aria-label={L(`${outCount} puntate uscite su ${chapters.length}`, `${outCount} of ${chapters.length} episodes out`)}>
              <span class="fb-progress__bar"><i style={`width: ${Math.max(2, (outCount / chapters.length) * 100)}%`}></i></span>
              <span class="fb-progress__txt">{L('Puntate uscite', 'Episodes out')}: <b>{outCount}</b> / {chapters.length}</span>
            </div>
            <div class="row" style="gap: 12px; padding-top: 4px;">
              {firstOut
                ? <a class="fb-btn" href={chHref(firstOut)}>{L('Inizia a leggere', 'Start reading')}</a>
                : <a class="fb-btn" href={`/${lang}/#lista`}>{L('Avvisami alla prima puntata', 'Tell me when it starts')}</a>}
              {firstOut && <a class="fb-btn fb-btn--ghost" href={`/${lang}/#lista`}>{L('Avvisami delle nuove puntate', 'Notify me of new episodes')}</a>}
            </div>
          </div>
        </div>
        <ol class="fb-episodes">
          {win.shown.map((c, i) => {
            const f = chapterOut(c, lang) ? chHref(c) : '';
            const next = !f && i === nextIdx;
            const inner = (
              <>
                <span class="fb-ep__n" aria-hidden="true">{i === 0 && !/\d/.test(c.label[lang]) ? '❦' : i}</span>
                <span class="fb-ep__label">{c.label[lang]}</span>
                <span class="fb-ep__title">{c.title[lang]}</span>
                <span class="fb-ep__state">{f ? L('Leggi →', 'Read →') : next ? L('Prossima puntata', 'Next episode') : L('In arrivo', 'Coming soon')}</span>
              </>
            );
            return (
              <li class={`fb-ep${f ? ' is-out' : ''}${next ? ' is-next' : ''}`}>
                {f ? <a href={f}>{inner}</a> : <div>{inner}</div>}
              </li>
            );
          })}
          {win.rest > 0 && (
            <li class="fb-ep fb-ep--rest"><div>
              <span class="fb-ep__n" aria-hidden="true">…</span>
              <span class="fb-ep__label">{L(`Capitoli ${win.from}–${win.to}`, `Chapters ${win.from}–${win.to}`)}</span>
              <span class="fb-ep__title">{L(`Altri ${win.rest} capitoli`, `${win.rest} more chapters`)}</span>
              <span class="fb-ep__state">{L('In arrivo', 'Coming soon')}</span>
            </div></li>
          )}
        </ol>
      </div>
    </section>
  )}

  <!-- Eroi -->
  <section id="compagnia" class="container stack" style="padding-block: 96px; gap: 40px;">
    <div class="fb-head">
      <p class="fb-kicker">{L('La compagnia', 'The fellowship')}</p>
      <h2 class="fb-h2">{s.heroes.title[lang]}</h2>
      {s.heroes.note?.[lang] && <p class="fb-body" style="max-width: 640px; margin-inline: auto;">{s.heroes.note[lang]}</p>}
    </div>
    <div class="fb-heroes">
      {s.heroes.list.map((h) => (
        <article class="fb-hero-card">
          <div class="fb-portrait"><img src={h.image} alt={h.alt[lang]} loading="lazy" width="640" height="640" /></div>
          <h3>{h.name}</h3>
          <p class="fb-label">{h.role[lang]}</p>
          <p class="fb-body">{h.bio[lang]}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Paesaggi -->
  {s.landscapes && s.landscapes.list.length > 0 && (
    <section class="fb-band fb-band--meadow">
      <div class="container stack" style="gap: 32px;">
        <div class="fb-head">
          <p class="fb-kicker">{L('Tessera dopo tessera', 'Tile by tile')}</p>
          <h2 class="fb-h2">{s.landscapes.title[lang]}</h2>
        </div>
        <div class="fb-mosaic">
          {s.landscapes.list.map((x, i) => (
            <figure class="fb-postcard">
              <img src={x.image} alt={x.caption[lang]} loading="lazy" width="640" height="640" />
              <figcaption>{x.caption[lang]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Popoli -->
  <section class="fb-band fb-band--parchment">
    <div class="container stack" style="gap: 32px;">
      <div class="fb-head">
        <p class="fb-kicker">{L('Chi abita la valle', 'Who lives in the valley')}</p>
        <h2 class="fb-h2">{s.peoples.title[lang]}</h2>
        <p class="fb-body" style="max-width: 680px;">{s.peoples.more[lang]}</p>
      </div>
      <div class="mg-peoples">
        {s.peoples.list.map((p) => (
          <article class={`mg-people${p.rare ? ' is-rare' : ''}`}>
            {p.image && <div class="mg-people__img"><img src={p.image} alt="" loading="lazy" width="640" height="640" /></div>}
            <div class="mg-people__body">
              {p.rare && <span class="mg-people__tag">{L('Stirpe rara', 'Rare lineage')}</span>}
              <strong>{p.name[lang]}</strong>
              <span>{p.text[lang]}</span>
              <small>{p.where[lang]}</small>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Atlante: mappa che segue lo scorrimento, luoghi cliccabili -->
  <section id="atlante" class="mo-atlas container" data-atlas>
    <div class="fb-head">
      <p class="fb-kicker">{L('Per sentieri e colline', 'Along paths and hills')}</p>
      <h2 class="fb-h2">{s.atlas.title[lang]}</h2>
      {s.atlas.note && <p class="fb-body">{s.atlas.note[lang]}</p>}
    </div>
    <div class="mo-atlas__grid">
      <div class="mo-atlas__stage">
        <div class="mo-atlas__frame">
          <div class="mo-atlas__view">
            <div class="mo-atlas__map" data-map>
              {s.atlas.map && <img src={s.atlas.map} alt={s.atlas.mapAlt?.[lang] ?? ''} loading="lazy" width="1800" height="1403" />}
              {places.map((pl, i) => (
                <button type="button" class="mo-spot" style={`left:${pl.x}%;top:${pl.y}%`} data-place={i} data-region={pl.region} aria-label={pl.name}><span aria-hidden="true"></span></button>
              ))}
            </div>
          </div>
          <article class="mo-card" data-card hidden aria-live="polite">
            <img data-card-img src="" alt="" width="640" height="640" />
            <div class="mo-card__body">
              <p class="fb-label" data-card-region></p>
              <h3 data-card-name></h3>
              <p data-card-text></p>
            </div>
            <button type="button" class="mo-card__close" data-card-close aria-label={L('Chiudi la scheda', 'Close the card')}>×</button>
          </article>
        </div>
        <button type="button" class="mo-atlas__all" data-all>{L('Tutta la mappa', 'Whole map')}</button>
      </div>
      <ol class="mo-atlas__regions">
        {s.atlas.list.map((r, ri) => (
          <li class="mo-region" data-region-item={ri} data-x={r.x ?? 50} data-y={r.y ?? 50} data-zoom={r.zoom ?? 1}>
            {r.image && <img class="mo-region__img" src={r.image} alt="" loading="lazy" width="640" height="640" />}
            <div class="mo-region__body">
              <span class="fb-label">{r.dir[lang]}</span>
              <h3>{r.name}</h3>
              <p>{r.text[lang]}</p>
              {places.some((pl) => pl.region === ri) && (
                <ul class="mo-chips">
                  {places.map((pl, i) => pl.region === ri && <li><button type="button" data-place={i}>{pl.name}</button></li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
    <script type="application/json" data-places set:html={JSON.stringify(places.map((pl) => ({ n: pl.name, r: s.atlas.list[pl.region]?.name ?? '', i: pl.image ?? '', t: pl.text[lang], x: pl.x, y: pl.y })))}></script>
  </section>
  <script>
    document.querySelectorAll<HTMLElement>('[data-atlas]').forEach((root) => {
      const map = root.querySelector<HTMLElement>('[data-map]')!;
      const card = root.querySelector<HTMLElement>('[data-card]')!;
      const data = JSON.parse(root.querySelector('[data-places]')!.textContent || '[]');
      const spots = [...root.querySelectorAll<HTMLElement>('.mo-spot')];
      const regions = [...root.querySelectorAll<HTMLElement>('[data-region-item]')];
      let lastFocus: HTMLElement | null = null;
      let active = -1;
      const go = (x: number, y: number, z: number) => {
        const cl = (v: number) => Math.min(0, Math.max(100 - 100 * z, v));
        map.style.setProperty('--z', String(z));
        map.style.transform = `translate(${cl(50 - x * z)}%, ${cl(50 - y * z)}%) scale(${z})`;
      };
      const setRegion = (i: number) => {
        if (i === active) return;
        active = i;
        regions.forEach((r, k) => r.classList.toggle('is-active', k === i));
        spots.forEach((s) => s.classList.toggle('is-region', Number(s.dataset.region) === i));
        if (i < 0) return go(50, 50, 1);
        const r = regions[i];
        go(Number(r.dataset.x), Number(r.dataset.y), Number(r.dataset.zoom));
      };
      const open = (i: number, from: HTMLElement) => {
        const p = data[i]; if (!p) return;
        lastFocus = from;
        (card.querySelector('[data-card-img]') as HTMLImageElement).src = p.i;
        card.querySelector('[data-card-region]')!.textContent = p.r;
        card.querySelector('[data-card-name]')!.textContent = p.n;
        card.querySelector('[data-card-text]')!.textContent = p.t;
        card.hidden = false;
        spots.forEach((s) => s.classList.toggle('is-open', Number(s.dataset.place) === i));
        const z = Math.max(2.2, Number(map.style.getPropertyValue('--z')) || 1);
        go(p.x, p.y + 8, z);
        if (from.closest('.mo-chips') && window.matchMedia('(max-width: 900px)').matches) root.querySelector('.mo-atlas__stage')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
        (card.querySelector('[data-card-close]') as HTMLElement).focus({ preventScroll: true });
      };
      const close = () => {
        if (card.hidden) return;
        card.hidden = true;
        spots.forEach((s) => s.classList.remove('is-open'));
        lastFocus?.focus({ preventScroll: true });
      };
      root.querySelectorAll<HTMLElement>('[data-place]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.place), b)));
      card.querySelector('[data-card-close]')!.addEventListener('click', close);
      root.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') close(); });
      root.querySelector('[data-all]')!.addEventListener('click', () => { close(); active = -2; setRegion(-1); });
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) setRegion(Number((e.target as HTMLElement).dataset.regionItem)); });
      }, { rootMargin: '-45% 0px -45% 0px' });
      regions.forEach((r) => io.observe(r));
      go(50, 50, 1);
    });
  </script>

  <Playtest lang={lang} p={s.playtest} skin="fiaba" />
  <Quotes lang={lang} quotes={s.quotes} skin="fiaba" />

  <!-- Citazione -->
  <section class="container" style="padding-block: 96px;">
    <figure class="fb-quote">
      <blockquote>«{s.quote.text[lang]}»</blockquote>
      <figcaption>{s.quote.who[lang]}</figcaption>
    </figure>
  </section>

  <!-- Bestiario -->
  <section class="fb-band fb-band--forest">
    <div class="container stack" style="gap: 22px; align-items: center; text-align: center;">
      {s.bestiary.image && <figure class="mg-beast"><img src={s.bestiary.image} alt={s.bestiary.imageAlt?.[lang] ?? ''} loading="lazy" width="640" height="640" /></figure>}
      <p class="fb-kicker">{L('Nel bosco, dopo il tramonto che non arriva', 'In the woods, after the sunset that never comes')}</p>
      <h2 class="fb-h2">{s.bestiary.title[lang]}</h2>
      <p class="fb-body" style="max-width: 720px;">{s.bestiary.text[lang]}</p>
      <div class="fb-seals">
        {s.bestiary.names.map((n) => <span>{n}</span>)}
      </div>
    </div>
  </section>

  <!-- Donazioni -->
  <section id="sostienici" class="fb-band fb-band--sun">
    <div class="container stack" style="gap: 14px; align-items: center; text-align: center;">
      <img class="mo-coins" src="/img/meriggio/mo/monete.webp" alt="" loading="lazy" width="640" height="640" />
      <p class="fb-kicker">{L('Una moneta per il cantastorie', 'A coin for the storyteller')}</p>
      <h2 class="fb-h2">{L('Ti è piaciuta la fiaba?', 'Enjoyed the fairy tale?')}</h2>
      <p class="fb-body" style="max-width: 600px;">{L('Offri un caffè agli autori: aiuta a scrivere l’Atto II.', 'Buy the authors a coffee: it helps write Act II.')}</p>
      {site.kofi
        ? <a class="fb-btn" href={site.kofi} target="_blank" rel="noopener">{t(lang, 'kofi.button')}</a>
        : <span class="fb-btn" aria-disabled="true" style="opacity: .55;">{L('Ko-fi in arrivo', 'Ko-fi coming soon')}</span>}
    </div>
  </section>

  <p slot="licence" class="fb-small" style="margin: 0;">{s.licence[lang]}</p>
</Base>
