---
// Pagina di Meriggio: grafica da libro di fiabe (pergamena calda, oro, verde bosco).
import '@fontsource/cinzel-decorative/700.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import Base from '../layouts/Base.astro';
import Quotes from './Quotes.astro';
import { t, sections, type Lang } from '../i18n/ui';
import { site, tl, type Setting } from '../data/catalog';

interface Props { lang: Lang; s: Setting; altPath: string }
const { lang, s, altPath } = Astro.props;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const novelBook = s.books.find((b) => b.n === '❦');
const gameBooks = s.books.filter((b) => b.n !== '❦');
const roman = ['I', 'II', 'III', 'IV', 'V'];
const chapters = s.novel?.chapters ?? [];
const outCount = chapters.filter((c) => c.file?.[lang]).length;
const firstOut = chapters.find((c) => c.file?.[lang]);
const nextIdx = chapters.findIndex((c) => !c.file?.[lang]);
---
<Base lang={lang} title={s.title} description={s.short[lang]} altPath={altPath} bodyClass="skin-fiaba" extraFonts>
  <div class="fb-motes" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>

  <!-- Copertina -->
  <section class="fb-cover">
    <div class="container" style="padding-top: 22px;">
      <nav class="crumbs fb-crumbs" aria-label={L('Percorso', 'Breadcrumb')}><a href={`/${lang}/`}>{t(lang, 'crumb.home')}</a> › <a href={`/${lang}/${sections[lang].rpg}/`}>{t(lang, 'nav.rpg')}</a> › {s.title}</nav>
    </div>
    <figure class="fb-cover__art">
      <img src={s.banner} width="1983" height="793" alt={s.bannerAlt[lang]} fetchpriority="high" />
    </figure>
    <div class="container fb-cover__body">
      <h1 class="sr-only">{s.title}</h1>
      <p class="fb-kicker">{L('C’era una volta, in una valle sempre al sole…', 'Once upon a time, in a valley always in the sun…')}</p>
      <p class="fb-tagline">{s.tagline[lang]}</p>
      <span class="fb-divider" aria-hidden="true"></span>
      <nav class="fb-paths" aria-label={L('Cosa trovi in Meriggio', 'What you’ll find in Meriggio')}>
        <a href="#libri" class="fb-path">
          <span class="fb-path__icon" aria-hidden="true">📜</span>
          <strong>{L('I libri del gioco', 'The game books')}</strong>
          <span>{L('Guida al mondo, avventura e bestiario per chi narra', 'World guide, adventure and bestiary for the storyteller')}</span>
        </a>
        {s.novel && (
          <a href="#romanzo" class="fb-path">
            <span class="fb-path__icon" aria-hidden="true">❦</span>
            <strong>{L('Il romanzo a puntate', 'The serial novel')}</strong>
            <span>{tl(lang, s.novelTitle, s.novelTitleEn)} · {L('un capitolo alla volta', 'one chapter at a time')}</span>
          </a>
        )}
        <a href="#compagnia" class="fb-path">
          <span class="fb-path__icon" aria-hidden="true">✦</span>
          <strong>{L('La valle e i suoi eroi', 'The valley and its heroes')}</strong>
          <span>{L('Personaggi, luoghi, genti e creature', 'Characters, places, peoples and creatures')}</span>
        </a>
      </nav>
    </div>
  </section>

  <!-- Presentazione -->
  <section class="container fb-intro">
    <div class="stack" style="gap: 18px; flex: 1 1 540px; min-width: 0;">
      <p class="fb-label">{s.tag[lang]}</p>
      {s.intro[lang].map((p, i) => <p class={i === 0 ? 'fb-lead fb-dropcap' : 'fb-body'}>{p}</p>)}
    </div>
    <aside class="stack" style="flex: 1 1 320px; min-width: 0; gap: 22px;">
      <div class="fb-scroll">
        <p class="fb-label" style="text-align: center;">{t(lang, 'rpg.sheet')}</p>
        <dl>
          {s.sheet.map((x) => (<><dt>{x.label[lang]}</dt><dd>{x.value[lang]}</dd></>))}
        </dl>
      </div>
      <blockquote class="fb-motto">
        <p>«{s.motto[lang]}»</p>
        <footer>{L('La regola d’oro per raccontare Meriggio', 'The golden rule for telling Meriggio')}</footer>
      </blockquote>
    </aside>
  </section>

  <!-- Libri del gioco -->
  <section id="libri" class="fb-band fb-band--meadow">
    <div class="container stack" style="gap: 40px;">
      <div class="fb-head">
        <p class="fb-kicker">{L('Per chi narra · la biblioteca della valle', 'For the storyteller · the valley library')}</p>
        <h2 class="fb-h2">{L('I libri del gioco', 'The game books')}</h2>
        <p class="fb-body" style="max-width: 640px;">{L('Tutto il necessario per giocare Meriggio con la 5ª edizione: il mondo, la prima avventura e le creature che la abitano.', 'Everything you need to play Meriggio with 5th edition: the world, the first adventure and the creatures that live in it.')}</p>
      </div>
      <div class="fb-books">
        {gameBooks.map((b, i) => {
          const f = b.file?.[lang] || b.file?.it;
          return (
            <article class={`fb-book fb-book--${i % 4}`}>
              {b.cover && <div class="fb-book__cover"><img src={b.cover} alt="" loading="lazy" width="1400" height="933" /><span class="fb-book__seal">{roman[i] ?? b.n}</span></div>}
              <div class="fb-book__body">
                <p class="fb-label">{L('Libro', 'Book')} {roman[i] ?? b.n}</p>
                <h3>{b.title[lang]}</h3>
                <p>{b.text[lang]}</p>
                {f
                  ? <a href={f} class="fb-book__dl" download={f.startsWith('#') ? undefined : ''}>{b.action[lang]}</a>
                  : <span class="fb-book__dl fb-book__dl--soon">{b.action[lang]} · {L('in arrivo', 'coming soon')}</span>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Romanzo a puntate -->
  {s.novel && (
    <section id="romanzo" class="fb-band fb-band--dusk">
      <div class="container stack" style="gap: 48px;">
        <div class="fb-novel-head">
          <div class="fb-novel-cover">
            <img src={novelBook?.cover || s.image} alt={L(`La copertina di ${tl(lang, s.novelTitle, s.novelTitleEn)}`, `The cover of ${tl(lang, s.novelTitle, s.novelTitleEn)}`)} loading="lazy" width="900" height="900" />
          </div>
          <div class="stack" style="flex: 1 1 380px; min-width: 0; gap: 16px;">
            <p class="fb-kicker">{s.novel.kicker[lang]}</p>
            <h2 class="fb-h2">{tl(lang, s.novelTitle, s.novelTitleEn)}</h2>
            <p class="fb-body">{s.novel.text[lang]}</p>
            <div class="fb-progress" role="img" aria-label={L(`${outCount} puntate uscite su ${s.novel.chapters.length}`, `${outCount} of ${s.novel.chapters.length} episodes out`)}>
              <span class="fb-progress__bar"><i style={`width: ${Math.max(2, (outCount / s.novel.chapters.length) * 100)}%`}></i></span>
              <span class="fb-progress__txt">{L('Puntate uscite', 'Episodes out')}: <b>{outCount}</b> / {s.novel.chapters.length}</span>
            </div>
            <div class="row" style="gap: 12px; padding-top: 4px;">
              {firstOut
                ? <a class="fb-btn" href={firstOut.file[lang]} target="_blank" rel="noopener">{L('Inizia a leggere', 'Start reading')}</a>
                : <a class="fb-btn" href={`/${lang}/#lista`}>{L('Avvisami alla prima puntata', 'Tell me when it starts')}</a>}
              {firstOut && <a class="fb-btn fb-btn--ghost" href={`/${lang}/#lista`}>{L('Avvisami delle nuove puntate', 'Notify me of new episodes')}</a>}
            </div>
          </div>
        </div>
        <ol class="fb-episodes">
          {s.novel.chapters.map((c, i) => {
            const f = c.file?.[lang];
            const next = !f && i === nextIdx;
            const inner = (
              <>
                <span class="fb-ep__n" aria-hidden="true">{i === 0 && !/\d/.test(c.label[lang]) ? '❦' : i}</span>
                <span class="fb-ep__label">{c.label[lang]}</span>
                <span class="fb-ep__title">{c.title[lang]}</span>
                <span class="fb-ep__state">{f ? L('Leggi →', 'Read →') : next ? L('Prossima puntata', 'Next episode') : L('In arrivo', 'Coming soon')}</span>
              </>
            );
            return (
              <li class={`fb-ep${f ? ' is-out' : ''}${next ? ' is-next' : ''}`}>
                {f ? <a href={f} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <!-- Eroi -->
  <section id="compagnia" class="container stack" style="padding-block: 96px; gap: 40px;">
    <div class="fb-head">
      <p class="fb-kicker">{L('La compagnia', 'The fellowship')}</p>
      <h2 class="fb-h2">{s.heroes.title[lang]}</h2>
      <p class="fb-body" style="max-width: 640px; margin-inline: auto;">{s.heroes.note[lang]}</p>
    </div>
    <div class="fb-heroes">
      {s.heroes.list.map((h) => (
        <article class="fb-hero-card">
          <div class="fb-portrait"><img src={h.image} alt={h.alt[lang]} loading="lazy" width="640" height="896" /></div>
          <h3>{h.name}</h3>
          <p class="fb-label">{h.role[lang]}</p>
          <p class="fb-body">{h.bio[lang]}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Paesaggi -->
  {s.landscapes && s.landscapes.list.length > 0 && (
    <section class="fb-band fb-band--meadow">
      <div class="container stack" style="gap: 32px;">
        <div class="fb-head">
          <p class="fb-kicker">{L('Dal taccuino di viaggio', 'From the travel sketchbook')}</p>
          <h2 class="fb-h2">{s.landscapes.title[lang]}</h2>
        </div>
        <div class="fb-mosaic">
          {s.landscapes.list.map((x, i) => (
            <figure class={`fb-postcard${i === 0 ? ' fb-postcard--big' : ''}`}>
              <img src={x.image} alt={x.caption[lang]} loading="lazy" width="1400" height="933" />
              <figcaption>{x.caption[lang]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Popoli e atlante -->
  <section class="fb-band fb-band--parchment">
    <div class="container row" style="gap: 56px; align-items: flex-start;">
      <div class="stack" style="flex: 1 1 520px; min-width: 0; gap: 20px;">
        <p class="fb-kicker">{L('Chi abita la valle', 'Who lives in the valley')}</p>
        <h2 class="fb-h2">{s.peoples.title[lang]}</h2>
        <div class="fb-peoples">
          {s.peoples.list.map((p) => (
            <div class="fb-people">
              <strong>{p.name[lang]}</strong>
              <span>{p.text[lang]}</span>
              <small>{p.where[lang]}</small>
            </div>
          ))}
        </div>
        <p class="fb-body" style="font-style: italic;">{s.peoples.more[lang]}</p>
      </div>
      <div class="stack" style="flex: 1 1 380px; min-width: 0; gap: 20px;">
        <p class="fb-kicker">{L('Per sentieri e colline', 'Along paths and hills')}</p>
        <h2 class="fb-h2">{s.atlas.title[lang]}</h2>
        <div class="fb-compass" aria-hidden="true">✦</div>
        <ul class="fb-atlas">
          {s.atlas.list.map((a) => (
            <li><span class="fb-label">{a.dir[lang]}</span><strong>{a.name}</strong><span>{a.text[lang]}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Quotes lang={lang} quotes={s.quotes} skin="fiaba" />

  <!-- Citazione -->
  <section class="container" style="padding-block: 96px;">
    <figure class="fb-quote">
      <blockquote>«{s.quote.text[lang]}»</blockquote>
      <figcaption>{s.quote.who[lang]}</figcaption>
    </figure>
  </section>

  <!-- Bestiario -->
  <section class="fb-band fb-band--forest">
    <div class="container stack" style="gap: 22px; align-items: center; text-align: center;">
      <p class="fb-kicker">{L('Nel bosco, dopo il tramonto che non arriva', 'In the woods, after the sunset that never comes')}</p>
      <h2 class="fb-h2">{s.bestiary.title[lang]}</h2>
      <p class="fb-body" style="max-width: 720px;">{s.bestiary.text[lang]}</p>
      <div class="fb-seals">
        {s.bestiary.names.map((n) => <span>{n}</span>)}
      </div>
    </div>
  </section>

  <!-- Donazioni -->
  <section id="sostienici" class="fb-band fb-band--sun">
    <div class="container stack" style="gap: 14px; align-items: center; text-align: center;">
      <p class="fb-kicker">{L('Una moneta per il cantastorie', 'A coin for the storyteller')}</p>
      <h2 class="fb-h2">{L('Ti è piaciuta la fiaba?', 'Enjoyed the fairy tale?')}</h2>
      <p class="fb-body" style="max-width: 600px;">{L('Offri un caffè agli autori: aiuta a scrivere l’Atto II.', 'Buy the authors a coffee: it helps write Act II.')}</p>
      {site.kofi
        ? <a class="fb-btn" href={site.kofi} target="_blank" rel="noopener">{t(lang, 'kofi.button')}</a>
        : <span class="fb-btn" aria-disabled="true" style="opacity: .55;">{L('Ko-fi in arrivo', 'Ko-fi coming soon')}</span>}
    </div>
  </section>

  <p slot="licence" class="fb-small" style="margin: 0;">{s.licence[lang]}</p>
</Base>
