---
import Base from '../../layouts/Base.astro';
import InterestForm from '../../components/InterestForm.astro';
import KofiBand from '../../components/KofiBand.astro';
import { t, langs, otherLang, sections, type Lang } from '../../i18n/ui';
import { games, rpgs, settings, news, site } from '../../data/catalog';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const h = site.home;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const nGames = games.length;
const nRpg = rpgs.length + settings.length;
---
<Base lang={lang} title="Dreamspace Ltd" altPath={`/${otherLang(lang)}/`}>
  <section class="container row" style="padding-block: 72px 80px; align-items: center; gap: 48px;">
    <div class="stack" style="flex: 1 1 480px; min-width: 0; gap: 24px;">
      <p class="label" style="margin: 0; color: var(--teal);">{h.kicker[lang]}</p>
      <h1 class="pixel h1">{h.title[lang]}</h1>
      <div class="bubble">
        <p>{h.bubble[lang]}</p>
        <p class="sig">{h.signature[lang]}</p>
      </div>
      <div class="portals">
        <a class="portal portal--games" href={`/${lang}/${sections[lang].games}/`}>
          <span class="portal__t">{t(lang, 'nav.games')}</span>
          <span class="portal__d">{L(`${nGames} giochi in arrivo · lista d'attesa`, `${nGames} games coming · waiting list`)}</span>
        </a>
        <a class="portal portal--rpg" href={`/${lang}/${sections[lang].rpg}/`}>
          <span class="portal__t">{t(lang, 'nav.rpg')}</span>
          <span class="portal__d">{L('avventure, ambientazioni e romanzi gratis', 'free adventures, settings and novels')}</span>
        </a>
      </div>
      <div class="row" style="gap: 10px;">
        <span class="chip">{t(lang, 'home.chip.free')}</span>
        <span class="chip">{t(lang, 'home.chip.langs')}</span>
        <span class="chip">{t(lang, 'home.chip.mobile')}</span>
      </div>
    </div>
    <div class="window" style="flex: 1 1 380px; min-width: 0; max-width: 460px; margin: 0 auto;">
      <div class="window__bar"><span>MARSYLVANIA.EXE</span><span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
      <img src={h.image} width="740" height="740" alt={L('Lord Caramel affronta con la spada di cristallo un verme gigante tra i canyon rossi di Marsylvania, in pixel art', 'Lord Caramel swings his crystal sword at a giant worm among the red canyons of Marsylvania, in pixel art')} style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" />
    </div>
  </section>

  <section id="novita" class="band-cream">
    <div class="container stack pad" style="gap: 32px;">
      <h2 class="pixel h2">{L('Novità', 'News')}</h2>
      <div class="cards news">
        {news.map((n) => (
          <article class="card">
            {n.image && <div class="card__media"><img src={n.image} width="960" height="600" alt="" loading="lazy" /></div>}
            <div class="card__body">
              <p class="card__tag"><time datetime={n.date}>{fmt(n.date)}</time></p>
              <h3 class="pixel h3">{n.title[lang]}</h3>
              <p>{n.text[lang]}</p>
              {n.link?.[lang] && <div class="card__foot" style="justify-content: flex-start;"><a class="btn btn--orange" href={n.link[lang]}>{L('Scopri', 'Find out more')}</a></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container stack" style="padding-block: 80px; gap: 32px;">
    <h2 class="pixel h2">{t(lang, 'home.how.title')}</h2>
    <div class="steps">
      <div class="step"><b style="color: var(--orange);">01</b><h3>{t(lang, 'home.how.1.t')}</h3><p>{t(lang, 'home.how.1.d')}</p></div>
      <div class="step"><b style="color: var(--teal);">02</b><h3>{t(lang, 'home.how.2.t')}</h3><p>{t(lang, 'home.how.2.d')}</p></div>
      <div class="step"><b style="color: #f2c230;">03</b><h3>{t(lang, 'home.how.3.t')}</h3><p>{t(lang, 'home.how.3.d')}</p></div>
    </div>
  </section>

  <InterestForm lang={lang} />
  <KofiBand lang={lang} />
</Base>
