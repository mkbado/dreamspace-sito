---
import Base from '../../layouts/Base.astro';
import InterestForm from '../../components/InterestForm.astro';
import KofiBand from '../../components/KofiBand.astro';
import { t, langs, otherLang, sections, type Lang } from '../../i18n/ui';
import { games, rpgs, settings, news, site } from '../../data/catalog';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const h = site.home;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const nGames = games.length;
const nRpg = rpgs.length + settings.length;
---
<Base lang={lang} title="Dreamspace Ltd" altPath={`/${otherLang(lang)}/`}>
  <section class="container row" style="padding-block: 72px 80px; align-items: center; gap: 48px;">
    <div class="stack" style="flex: 1 1 480px; min-width: 0; gap: 24px;">
      <p class="label" style="margin: 0; color: var(--teal);">{h.kicker[lang]}</p>
      <h1 class="pixel h1">{h.title[lang]}</h1>
      <div class="bubble">
        <p>{h.bubble[lang]}</p>
        <p class="sig">{h.signature[lang]}</p>
      </div>
      <div class="portals">
        <a class="portal portal--games" href={`/${lang}/${sections[lang].games}/`}>
          <span class="portal__t">{t(lang, 'nav.games')}</span>
          <span class="portal__d">{L(`${nGames} giochi in arrivo · lista d'attesa`, `${nGames} games coming · waiting list`)}</span>
        </a>
        <a class="portal portal--rpg" href={`/${lang}/${sections[lang].rpg}/`}>
          <span class="portal__t">{t(lang, 'nav.rpg')}</span>
          <span class="portal__d">{L('avventure, ambientazioni e romanzi gratis', 'free adventures, settings and novels')}</span>
        </a>
      </div>
      <div class="row" style="gap: 10px;">
        <span class="chip">{t(lang, 'home.chip.free')}</span>
        <span class="chip">{t(lang, 'home.chip.langs')}</span>
        <span class="chip">{t(lang, 'home.chip.mobile')}</span>
      </div>
    </div>
    <div class="slider" data-slider style="flex: 1 1 380px; min-width: 0; max-width: 460px; margin: 0 auto;">
      <div class="window" role="region" aria-roledescription={L('carosello', 'carousel')} aria-label={L('I nostri giochi', 'Our games')}>
        <div class="window__bar" data-bar style={`background: ${h.slides[0]?.color};`}>
          <span data-file aria-hidden="true">{h.slides[0]?.file}</span>
          <span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <div class="slides">
          {h.slides.map((sl, i) => (
            <a class="slide" href={sl.link[lang]} data-file={sl.file} data-color={sl.color} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${h.slides.length}: ${sl.title}`}>
              <img src={sl.image} width="740" height="740" alt={sl.alt[lang]} loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="slide__cap">
                <strong>{sl.title}</strong>
                <span>{sl.text[lang]}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
      {h.slides.length > 1 && (
        <div class="slider__nav">
          <button type="button" class="slider__arrow" data-prev aria-label={L('Precedente', 'Previous')}>◀</button>
          <div class="slider__dots">
            {h.slides.map((sl, i) => <button type="button" data-go={i} aria-label={sl.title} aria-current={i === 0 ? 'true' : undefined}></button>)}
          </div>
          <button type="button" class="slider__arrow" data-pause aria-label={L('Ferma', 'Pause')} aria-pressed="false">❚❚</button>
          <button type="button" class="slider__arrow" data-next aria-label={L('Successivo', 'Next')}>▶</button>
        </div>
      )}
    </div>
  </section>

  <section id="novita" class="band-cream">
    <div class="container stack pad" style="gap: 32px;">
      <h2 class="pixel h2">{L('Novità', 'News')}</h2>
      <div class="cards news">
        {news.map((n) => (
          <article class="card">
            {n.image && <div class="card__media"><img src={n.image} width="960" height="600" alt="" loading="lazy" /></div>}
            <div class="card__body">
              <p class="card__tag"><time datetime={n.date}>{fmt(n.date)}</time></p>
              <h3 class="pixel h3">{n.title[lang]}</h3>
              <p>{n.text[lang]}</p>
              {n.link?.[lang] && <div class="card__foot" style="justify-content: flex-start;"><a class="btn btn--orange" href={n.link[lang]}>{L('Scopri', 'Find out more')}</a></div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container stack" style="padding-block: 80px; gap: 32px;">
    <h2 class="pixel h2">{t(lang, 'home.how.title')}</h2>
    <div class="steps">
      <div class="step"><b style="color: var(--orange);">01</b><h3>{t(lang, 'home.how.1.t')}</h3><p>{t(lang, 'home.how.1.d')}</p></div>
      <div class="step"><b style="color: var(--teal);">02</b><h3>{t(lang, 'home.how.2.t')}</h3><p>{t(lang, 'home.how.2.d')}</p></div>
      <div class="step"><b style="color: #f2c230;">03</b><h3>{t(lang, 'home.how.3.t')}</h3><p>{t(lang, 'home.how.3.d')}</p></div>
    </div>
  </section>

  <InterestForm lang={lang} />
  <KofiBand lang={lang} />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLAnchorElement>('.slide')];
    if (slides.length < 2) return;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const file = root.querySelector<HTMLElement>('[data-file]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    let paused = reduce;
    let hover = false;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === i;
        s.classList.toggle('is-on', on);
        if (on) { s.removeAttribute('aria-hidden'); s.removeAttribute('tabindex'); }
        else { s.setAttribute('aria-hidden', 'true'); s.tabIndex = -1; }
        if (on) s.querySelector('img')?.setAttribute('loading', 'eager');
      });
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      bar.style.background = slides[i].dataset.color ?? '';
      file.textContent = slides[i].dataset.file ?? '';
    };
    const tick = () => {
      window.clearInterval(timer);
      if (!paused && !hover) timer = window.setInterval(() => show(i + 1), 5000);
    };
    const setPaused = (p: boolean) => {
      paused = p;
      pauseBtn.setAttribute('aria-pressed', String(p));
      pauseBtn.textContent = p ? '▶▶' : '❚❚';
      pauseBtn.setAttribute('aria-label', p ? pauseBtn.dataset.play ?? 'Play' : pauseBtn.dataset.stop ?? 'Pause');
      tick();
    };
    pauseBtn.dataset.stop = pauseBtn.getAttribute('aria-label') ?? 'Pause';
    pauseBtn.dataset.play = document.documentElement.lang === 'it' ? 'Riprendi' : 'Play';
    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(i - 1); tick(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(i + 1); tick(); });
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.go)); tick(); }));
    root.addEventListener('mouseenter', () => { hover = true; tick(); });
    root.addEventListener('mouseleave', () => { hover = false; tick(); });
    root.addEventListener('focusin', () => { hover = true; tick(); });
    root.addEventListener('focusout', () => { hover = false; tick(); });
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { show(dx < 0 ? i + 1 : i - 1); tick(); }
      x0 = null;
    });
    show(0);
    setPaused(paused);
  });
</script>
