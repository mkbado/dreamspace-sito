---
import Base from '../../layouts/Base.astro';
import InterestForm from '../../components/InterestForm.astro';
import KofiBand from '../../components/KofiBand.astro';
import { t, langs, otherLang, sections, type Lang } from '../../i18n/ui';
import { games, rpgs, settings, oneshots, novels, news, site, localImg, itemTitle, chapterOnline, readingMinutes } from '../../data/catalog';
import { itemPath, novelPath, novelsPath, chapterPath } from '../../data/paths';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const h = site.home;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const flag = games.find((g) => g.slug === 'marsylvania');
const tested = [...games, ...rpgs, ...settings, ...oneshots].filter((x) => x.playtest?.testers?.length);
const testers = new Set(tested.flatMap((x) => x.playtest!.testers));
const voices = tested.flatMap((x) => (x.playtest!.moments || []).slice(0, 1).map((m) => ({ text: m[lang], game: x, who: x.playtest!.testers })));

// «Stasera si legge»: il primo capitolo online di un romanzo, con l'incipit
const reads = novels
  .map((n) => ({ n, c: n.chapters.find((c) => chapterOnline(c, lang)), online: n.chapters.filter((c) => chapterOnline(c, lang)).length }))
  .filter((r) => r.c);
const read = reads[0];
const paras = read ? read.c!.text[lang].split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean) : [];
const excerpt: string[] = [];
for (const para of paras) { excerpt.push(para); if (excerpt.join(' ').length > 650) break; }
const soon = novels.filter((n) => !n.chapters.some((c) => chapterOnline(c, lang)));
---
<Base lang={lang} title="Dreamspace Ltd" altPath={`/${otherLang(lang)}/`} spaceIntro>
  <section class="container hero">
    <p class="label hero__kicker">{h.kicker[lang]}</p>
    <h1 class="pixel hero__title">{h.title[lang]}</h1>
    <div class="hero__memo">
      <p>{h.bubble[lang]}</p>
      <p class="sig">{h.signature[lang]}</p>
    </div>
    <nav class="hero__doors" aria-label={L('Da dove partire', 'Where to start')}>
      <a href={`/${lang}/${sections[lang].games}/`}><b>{t(lang, 'nav.games')}</b><span>{L('Gioca', 'Play')} →</span></a>
      <a href={`/${lang}/${sections[lang].rpg}/`}><b>{t(lang, 'nav.rpg')}</b><span>{L('Scarica e gioca', 'Download & play')} →</span></a>
      <a href={novelsPath(lang)}><b>{t(lang, 'nav.novels')}</b><span>{L('Leggi online', 'Read online')} →</span></a>
    </nav>
  </section>

  {flag && (
    <section class="flag" aria-labelledby="flag-t">
      <div class="flag__art"><img src={flag.banner} alt={flag.bannerAlt?.[lang] ?? ''} width="1882" height="836" loading="eager" /></div>
      <div class="container flag__in">
        <div class="flag__text">
          <p class="flag__kicker"><span class="flag__dot" aria-hidden="true"></span>{L('Missione di punta · Kickstarter in arrivo', 'Flagship mission · Kickstarter coming')}</p>
          <h2 id="flag-t" class="pixel flag__title">{itemTitle(lang, flag)}</h2>
          <p class="flag__pitch">{flag.pitch[lang]}</p>
          <ul class="flag__facts">
            <li><b>{flag.players}</b><span>{L('giocatori', 'players')}</span></li>
            <li><b>{flag.minutes}′</b><span>{L('a partita', 'per game')}</span></li>
            <li><b>{flag.age}</b><span>{L('età', 'age')}</span></li>
            <li><b>6</b><span>Dreamspacer</span></li>
          </ul>
          <div class="row" style="gap: 14px;">
            <a class="btn btn--orange btn--big" href="#lista">{L('Avvisami al lancio', 'Notify me at launch')}</a>
            <a class="btn btn--line btn--big" href={itemPath(lang, flag)}>{L('Scopri il gioco', 'Discover the game')}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {read && (
    <section class="container tonight" aria-labelledby="tonight-t">
      <p class="label home-kicker">{L('Stasera si legge', 'Tonight’s reading')}</p>
      <div class="tonight__box">
        <a class="tonight__cover" href={novelPath(lang, read.n)} tabindex="-1" aria-hidden="true">
          <img src={read.n.cover} alt="" width="1024" height="1536" loading="lazy" />
        </a>
        <div class="tonight__text">
          <h2 id="tonight-t" class="pixel h2">{read.n.title[lang]}</h2>
          <p class="tonight__meta">{read.c!.label[lang]} · {read.c!.title[lang]}{read.c!.narrator[lang] && <> · {L('narra', 'told by')} {read.c!.narrator[lang]}</>}</p>
          <div class="tonight__page">
            {excerpt.map((p) => <p>{p}</p>)}
          </div>
          <div class="tonight__foot">
            <a class="btn btn--teal btn--big" href={chapterPath(lang, read.n, read.c!)}>{L(`Continua a leggere · ${readingMinutes(read.c!.text[lang])} min`, `Keep reading · ${readingMinutes(read.c!.text[lang])} min`)}</a>
            <span>{L(`${read.online} capitoli già online, gratis`, `${read.online} chapters already online, free`)}</span>
          </div>
          {soon.length > 0 && (
            <p class="tonight__soon">{L('In arrivo', 'Coming soon')}: {soon.map((n, i) => <>{i > 0 && ', '}<a href={novelPath(lang, n)}>{n.title[lang]}</a></>)}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <section id="novita" class="container news" aria-labelledby="news-t">
    <p class="label home-kicker">{L('Dagli archivi', 'From the archives')}</p>
    <h2 id="news-t" class="pixel h2">{L('Novità', 'News')}</h2>
    <div class="news__grid">
      {news.map((n) => (
        <article class="ncard">
          {n.image && (n.link?.[lang]
            ? <a class="ncard__media" href={n.link[lang]} tabindex="-1" aria-hidden="true"><img src={localImg(n.image, lang)} width="960" height="600" alt="" loading="lazy" /></a>
            : <div class="ncard__media"><img src={localImg(n.image, lang)} width="960" height="600" alt="" loading="lazy" /></div>)}
          <div class="ncard__body">
            <p class="ncard__date"><time datetime={n.date}>{fmt(n.date)}</time></p>
            <h3>{n.link?.[lang] ? <a href={n.link[lang]}>{n.title[lang]}</a> : n.title[lang]}</h3>
            <p>{n.text[lang]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {site.crew && (
    <section class="container crew" aria-labelledby="crew-t">
      <p class="label home-kicker">{site.crew.kicker[lang]}</p>
      <h2 id="crew-t" class="pixel h2">{site.crew.title[lang]}</h2>
      <div class="crew__grid">
        {site.crew.items.map((c, i) => (
          <article class={`crew__card crew__card--${i % 4}`}>
            <div class="crew__badge"><b>{c.badge}</b><span>{c.unit[lang]}</span></div>
            <h3>{c.title[lang]}</h3>
            <p>{c.text[lang]}</p>
          </article>
        ))}
      </div>
      {voices.length > 0 && (
        <>
          <p class="label home-kicker" style="margin-top: 24px;">{L('Dal tavolo di prova', 'From the test table')}</p>
          <div class="voices__grid">
            {voices.map((v) => (
              <a class="voice" href={`${itemPath(lang, v.game)}#dream-tester`}>
                <p>{v.text}</p>
                <span class="voice__who">{L('Al tavolo', 'At the table')}: {v.who.join(', ')}</span>
                <span class="voice__game">{itemTitle(lang, v.game)} →</span>
              </a>
            ))}
          </div>
          <p style="margin: 0;"><a class="label" style="color: var(--teal);" href={`/${lang}/${lang === 'it' ? 'chi-siamo' : 'about'}/#dream-tester`}>{L(`Conosci i ${testers.size} Dream-tester`, `Meet the ${testers.size} Dream-testers`)} →</a></p>
        </>
      )}
    </section>
  )}

  <InterestForm lang={lang} preselect="marsylvania" />
  <KofiBand lang={lang} quiet />
</Base>
