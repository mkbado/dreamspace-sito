---
import Base from '../../../layouts/Base.astro';
import GameCard from '../../../components/GameCard.astro';
import RpgCard from '../../../components/RpgCard.astro';
import InterestForm from '../../../components/InterestForm.astro';
import KofiBand from '../../../components/KofiBand.astro';
import { t, langs, otherLang, sections, type Lang } from '../../../i18n/ui';
import { games, rpgs, settings, oneshots, site, tl, localImg, novels as allNovels } from '../../../data/catalog';
import { itemPath, novelsPath, novelPath } from '../../../data/paths';
import NovelList from '../../../components/NovelList.astro';

export function getStaticPaths() {
  return langs.flatMap((lang) => [
    { params: { lang, section: sections[lang].games }, props: { kind: 'games' as const } },
    { params: { lang, section: sections[lang].rpg }, props: { kind: 'rpg' as const } },
    { params: { lang, section: sections[lang].novels }, props: { kind: 'novels' as const } },
  ]);
}

const lang = Astro.params.lang as Lang;
const { kind } = Astro.props;
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const other = otherLang(lang);
const alt = `/${other}/${sections[other][kind]}/`;
const title = kind === 'games' ? t(lang, 'nav.games') : kind === 'rpg' ? t(lang, 'nav.rpg') : t(lang, 'nav.novels');
const intro = kind === 'games' ? site.boardgames.intro[lang] : kind === 'rpg' ? site.rpg.intro[lang]
  : L('Romanzi a puntate, gratis, nati dai nostri giochi di ruolo. Ogni capitolo si legge qui online oppure si scarica in PDF; quando ne esce uno nuovo, lo trovi qui sotto nella sua serie.', 'Free serial novels born from our roleplaying games. Read every chapter here online or download it as a PDF; new chapters appear right here, in their series.');

---
<Base lang={lang} title={title} description={intro} altPath={alt} extraFonts={kind === 'novels'}>
  <section class="container stack" style="padding-block: 56px 40px; gap: 16px;">
    <nav class="crumbs" aria-label={L('Percorso', 'Breadcrumb')}><a href={`/${lang}/`}>{t(lang, 'crumb.home')}</a> › {title}</nav>
    <p class="label" style="margin: 0; color: var(--teal);">{kind === 'games' ? L('Catalogo · in arrivo', 'Catalogue · coming soon') : kind === 'novels' ? L('Da leggere · gratis', 'To read · free') : L('Catalogo · gratis', 'Catalogue · free')}</p>
    <h1 class="pixel h1">{title}</h1>
    <p style="margin: 0; max-width: 720px; font-size: 19px; color: var(--soft);">{intro}</p>
  </section>

  {kind === 'novels' && (
    <nav class="container nv-toc" aria-label={L('Romanzi disponibili', 'Available novels')}>
      {allNovels.map((n) => <a href={`#${n.slug}`} class={`nv-toc__i nv-toc__i--${n.skin}`}><img src={localImg(n.cover, lang)} alt="" width="80" height="80" /><span><b>{n.title[lang]}</b><small>{n.series[lang]}</small></span></a>)}
    </nav>
  )}
  {kind === 'novels' && allNovels.map((n) => <NovelList lang={lang} n={n} />)}
  {kind !== 'novels' && <section class="band-cream">
    <div class="container stack pad" style="gap: 32px;">
      <div class="cards">
        {kind === 'games'
          ? games.map((g) => <GameCard lang={lang} g={g} />)
          : [...oneshots, ...rpgs, ...settings].map((x) => <RpgCard lang={lang} item={x} />)}
      </div>
    </div>
  </section>}

  {kind === 'rpg' && (
    <section id="romanzi" class="container stack" style="padding-block: 72px; gap: 24px;">
      <p class="label" style="margin: 0; color: var(--teal);">{L('Da leggere', 'To read')}</p>
      <h2 class="pixel h2">{t(lang, 'nav.novels')}</h2>
      <p style="margin: 0; max-width: 680px; color: var(--soft);">{L('Ogni gioco di ruolo ha il suo romanzo: si legge gratis, anche senza giocare.', 'Every roleplaying game has its own novel: free to read, even if you never play.')}</p>
      <div class="novels">
        {allNovels.map((n) => (
          <a class="novel" href={novelPath(lang, n)}>
            <span class="label">{n.series[lang]}</span>
            <strong>{n.title[lang]}</strong>
            <p>{n.text[lang]}</p>
            <span class="novel__go">{t(lang, 'card.read')} →</span>
          </a>
        ))}
      </div>
      <p style="margin: 0;"><a class="btn btn--teal" href={novelsPath(lang)}>{L('Tutti i romanzi e i capitoli', 'All novels and chapters')} →</a></p>
    </section>
  )}

  {kind === 'games' && <InterestForm lang={lang} />}
  <KofiBand lang={lang} />
</Base>
