---
import Base from '../../../layouts/Base.astro';
import PixelTable from '../../../components/PixelTable.astro';
import KofiBand from '../../../components/KofiBand.astro';
import NotifyBox from '../../../components/NotifyBox.astro';
import Quotes from '../../../components/Quotes.astro';
import BannerSpots from '../../../components/BannerSpots.astro';
import DreamspacerSheets from '../../../components/DreamspacerSheets.astro';
import { t, langs, otherLang, sections, type Lang } from '../../../i18n/ui';
import { games, rpgs, settings, type Game, type Rpg, type Setting, oneshots, type OneShot, localImg } from '../../../data/catalog';
import SettingPage from '../../../components/SettingPage.astro';
import CircoloPage from '../../../components/CircoloPage.astro';
import OneShotPage from '../../../components/OneShotPage.astro';
import { itemPath } from '../../../data/paths';

export function getStaticPaths() {
  return langs.flatMap((lang) => [
    ...games.map((item) => ({ params: { lang, section: sections[lang].games, slug: item.slug }, props: { item } })),
    ...rpgs.map((item) => ({ params: { lang, section: sections[lang].rpg, slug: item.slug }, props: { item } })),
    ...settings.map((item) => ({ params: { lang, section: sections[lang].rpg, slug: item.slug }, props: { item } })),
    ...oneshots.map((item) => ({ params: { lang, section: sections[lang].rpg, slug: item.slug }, props: { item } })),
  ]);
}

const lang = Astro.params.lang as Lang;
const { item } = Astro.props as { item: Game | Rpg | Setting | OneShot };
const alt = itemPath(otherLang(lang), item);
const L = (it: string, en: string) => (lang === 'it' ? it : en);
const g = item.kind === 'game' ? item : null;
const r = item.kind === 'rpg' ? item : null;
const st = item.kind === 'setting' ? item : null;
const os = item.kind === 'oneshot' ? item : null;
---
{st && <SettingPage lang={lang} s={st} altPath={alt} />}
{os && <OneShotPage lang={lang} o={os} altPath={alt} />}

{g && (
<Base lang={lang} title={g.title} description={g.short[lang]} altPath={alt}>
  {g.banner && g.characters?.list.some((c) => c.spot) && <BannerSpots lang={lang} g={g} />}
  {g.banner && !g.characters?.list.some((c) => c.spot) && (
    <section style="border-bottom: 4px solid var(--black); background: var(--black);">
      <img src={g.banner} width="1881" height="836" alt={g.bannerAlt![lang]} style="width: 100%; max-height: 640px; object-fit: cover; object-position: center;" />
    </section>
  )}
  <section class="container stack" style="padding-block: 40px 72px; gap: 28px;">
    <nav class="crumbs" aria-label={L('Percorso', 'Breadcrumb')}><a href={`/${lang}/`}>{t(lang, 'crumb.home')}</a> › <a href={`/${lang}/${sections[lang].games}/`}>{t(lang, 'nav.games')}</a> › {g.title}</nav>
    <div class="row" style="gap: 48px; align-items: flex-start;">
      {!g.banner && <div class="window" style={g.heroPortrait ? 'flex: 0 1 380px; min-width: 0; margin-inline: auto;' : g.heroSquare ? 'flex: 0 1 460px; min-width: 0; margin-inline: auto;' : 'flex: 1 1 520px; min-width: 0;'}>
        <div class="window__bar"><span>{g.fileName ?? `${g.slug.toUpperCase()}.PNG`}</span><span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
        {g.heroImage
          ? <img src={localImg(g.heroImage, lang)} alt={g.heroAlt![lang]} style={`width: 100%; aspect-ratio: ${g.heroPortrait ? '2 / 3' : g.heroSquare ? '1 / 1' : '16 / 10'}; object-fit: cover;`} />
          : <img src={localImg(g.image, lang)} alt={g.imageAlt![lang]} style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover;" />}
      </div>}
      <div class="stack" style="flex: 1 1 400px; min-width: 0; gap: 20px;">
        <p class="label" style="margin: 0; color: var(--teal);">{g.tag[lang]}</p>
        <h1 class="pixel" style="font-size: clamp(38px, 5vw, 56px);">{g.title}</h1>
        <div class="row" style="gap: 12px;">
          <div class="stat"><b>{g.players}</b><span>{t(lang, 'game.players')}</span></div>
          <div class="stat"><b>{g.minutes}</b><span>{t(lang, 'game.minutes')}</span></div>
          {g.age && <div class="stat"><b>{g.age}</b><span>{t(lang, 'game.age')}</span></div>}
        </div>
        <p style="margin: 0; font-size: 18px; color: #dde1f7;">{g.pitch[lang]}</p>
        {!g.banner && <NotifyBox lang={lang} game={g} />}
      </div>
      {g.banner && <div style="flex: 1 1 380px; min-width: 0; align-self: center;"><NotifyBox lang={lang} game={g} /></div>}
    </div>
  </section>

  {g.features && (
    <section class="container stack" style="padding-bottom: 72px; gap: 28px;">
      <h2 class="pixel" style="font-size: 40px;">{g.features.title[lang]}</h2>
      <div class="steps">
        {g.features.list.map((f, i) => (
          <div class="step">
            <b style={`color: ${['var(--orange)', 'var(--teal)', '#f2c230', '#ee7fb0', '#9be15d', '#8a5cd8'][i % 6]}; font-size: 20px;`}>{String(i + 1).padStart(2, '0')}</b>
            <h3>{f.title[lang]}</h3>
            <p>{f.text[lang]}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {g.briefing && (
    <section class="band-cream">
      <div class="container row pad" style="gap: 48px;">
        <div class="stack" style="flex: 1 1 520px; min-width: 0; gap: 16px;">
          <p class="label" style="margin: 0; color: var(--orange-ink);">{g.briefing.kicker[lang]}</p>
          <h2 class="pixel" style="font-size: 40px;">{g.briefing.title[lang]}</h2>
          {g.briefing.paragraphs[lang].map((p) => <p style="margin: 0;">{p}</p>)}
        </div>
        <div class="stack" style="flex: 1 1 360px; min-width: 0; gap: 16px;">
          {g.briefing.areas.map((a) => (
            <div class="panel" style={a.dark ? 'background: var(--night); color: var(--cream);' : 'background: #fff;'}>
              <p class="label" style={`margin: 0 0 6px; color: ${a.dark ? 'var(--teal)' : 'var(--orange-ink)'};`}>{a.label[lang]}</p>
              <h3>{a.title[lang]}</h3>
              <p style={a.dark ? 'color: #dde1f7;' : ''}>{a.text[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {g.characters && (
    <section class="container stack" style="padding-block: 80px; gap: 28px;">
      <div class="row" style="align-items: end; justify-content: space-between; gap: 12px;">
        <h2 class="pixel" style="font-size: 40px;">{g.characters.title[lang]}</h2>
        <p class="muted" style="margin: 0; font-size: 14px;">{g.characters.note[lang]}</p>
      </div>
      {g.characters.list.some((c) => c.levels?.length) ? <DreamspacerSheets lang={lang} list={g.characters.list} /> :
      <div class="row" style="gap: 20px;">
        {g.characters.list.map((c) => (
          <article class="hero-card">
            <div class="hero-card__name" style={`background: ${c.color}; color: ${c.ink};`}>{c.title?.[lang] || c.name}{c.role?.[lang] ? <span style="opacity: .75;"> · {c.role[lang]}</span> : c.home && <span style="opacity: .75;"> · {c.home}</span>}</div>
            <div class="hero-card__img"><img src={c.image} alt={c.alt[lang]} loading="lazy" /></div>
            {c.bio[lang] ? <p>{c.bio[lang]}</p> : <p class="todo">{L('[Una riga su chi è e da dove viene]', '[One line on who they are and where they come from]')}</p>}
            {c.ability && <p class="ability"><span>{g.characters!.abilityLabel?.[lang] || L('Abilità', 'Ability')}</span> {c.ability[lang]}</p>}
          </article>
        ))}
      </div>}
    </section>
  )}

  {g.howToPlay && (
    <section class="container row" style="padding-bottom: 80px; gap: 48px; align-items: center;">
      <div class="stack" style="flex: 1 1 440px; min-width: 0; gap: 20px;">
        <h2 class="pixel" style="font-size: 40px;">{g.howToPlay.title[lang]}</h2>
        <ol class="phases">{g.howToPlay.steps[lang].map((s) => <li>{s}</li>)}</ol>
        <p style="margin: 0; color: var(--soft);">{g.howToPlay.note[lang]}</p>
      </div>
      {g.howToPlay.image && (
        g.howToPlay.imageBare
          ? <img src={g.howToPlay.image} alt={g.howToPlay.imageAlt![lang]} loading="lazy" style="flex: 1 1 480px; min-width: 0; width: 100%;" />
          : <div class="window" style="flex: 1 1 440px; min-width: 0;">
              <img src={g.howToPlay.image} width="920" height="530" alt={g.howToPlay.imageAlt![lang]} loading="lazy" style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover;" />
            </div>
      )}
    </section>
  )}

  {g.tableSections?.map((ts) => (
    <section class={ts.dark ? 'play-dark' : 'band-cream'} style="border-top: 4px solid var(--black);">
      <div class="container stack pad" style="gap: 48px;">
        <div class="stack" style="gap: 10px; max-width: 760px;">
          <p class="label play-kicker">{ts.kicker[lang]}</p>
          <h2 class="pixel" style="font-size: 40px;">{ts.title[lang]}</h2>
          <p class="play-intro">{ts.intro[lang]}</p>
        </div>
        {ts.blocks.map((b, k) => (
          <div class={`play-row${k % 2 ? ' play-row--rev' : ''}`}>
            <div class="stack" style="flex: 1 1 360px; min-width: 0; gap: 12px;">
              <p class="label play-kicker">{b.kicker[lang]}</p>
              <h3 class="pixel" style="font-size: 28px; line-height: 1.15;">{b.title[lang]}</h3>
              <p style="margin: 0; font-size: 17px;">{b.text[lang]}</p>
            </div>
            <div class="play-fan">
              {b.images.map((im) => im.kind === 'token'
                ? <figure class="play-token"><img src={im.image} width="160" height="160" alt={im.alt[lang]} loading="lazy" />{im.caption && <figcaption>{im.caption[lang]}</figcaption>}</figure>
                : <img class="play-card" src={im.image} width="400" height="558" alt={im.alt[lang]} loading="lazy" />)}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  {g.gallery && (
    <section class="band-cream" style="border-bottom: 0;">
      <div class="container stack pad" style="gap: 24px;">
        <div class="row" style="align-items: end; justify-content: space-between; gap: 12px;">
          <h2 class="pixel" style="font-size: 40px;">{g.gallery.title[lang]}</h2>
          <p style="margin: 0; font-size: 14px; color: var(--text-dim);">{g.gallery.note[lang]}</p>
        </div>
        <div class="gallery">
          {g.gallery.items.map((x) => (
            <figure>
              <img src={x.image} alt={x.alt[lang]} loading="lazy" />
              <figcaption><strong>{x.name[lang]}</strong><span>{x.quote[lang]}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {g.roster && (
    <section class="band-cream" style="border-bottom: 0;">
      <div class="container stack pad" style="gap: 24px;">
        <div class="row" style="align-items: end; justify-content: space-between; gap: 12px;">
          <h2 class="pixel" style="font-size: 40px;">{g.roster.title[lang]}</h2>
          <p style="margin: 0; font-size: 14px; color: var(--text-dim);">{g.roster.note[lang]}</p>
        </div>
        <div class="guests">
          {g.roster.items.map((x, i) => <div class="guest"><i style={`background: ${['#2ec4b6', '#d9442b', '#3fa34d', '#8a5cd8', '#5bb8f0', '#f2c230', '#12163a', '#ee7fb0', '#f28c28'][i % 9]};`}></i><span><strong>{x.name[lang]}</strong> · {x.role[lang]}</span></div>)}
        </div>
      </div>
    </section>
  )}

  {g.components && (
    <section class="band-cream" style={`border-bottom: 0;${g.gallery || g.roster ? ' border-top: 0;' : ''}`}>
      <div class="container stack" style={`padding-block: ${g.gallery || g.roster ? '0 64px' : '64px'}; gap: 24px;`}>
        <div class="row" style="align-items: end; justify-content: space-between; gap: 12px;">
          <h2 class="pixel" style="font-size: 36px;">{t(lang, 'game.components')}</h2>
          <p style="margin: 0; font-size: 14px; color: var(--text-dim);">{L('Contenuto previsto, può cambiare', 'Planned contents, may change')}</p>
        </div>
        <div class="row" style="gap: 14px;">
          {g.components.map((c) => <div class="box"><b>{c.n}</b>{c.label[lang]}</div>)}
        </div>
        {g.componentsExtra && <p style="margin: 0; color: var(--text-dim);">{g.componentsExtra[lang]}</p>}
      </div>
    </section>
  )}

  <Quotes lang={lang} quotes={g.quotes} />

  {g.team && (
    <section class="container row" style="padding-block: 72px; gap: 40px; align-items: center;">
      <div class="stack" style="flex: 1 1 480px; min-width: 0; gap: 16px;">
        <h2 class="pixel" style="font-size: 40px;">{g.team.title[lang]}</h2>
        <p style="margin: 0; color: var(--soft);">{g.team.text[lang]}</p>
      </div>
    </section>
  )}

  <section class="band-orange">
    <div class="container row" style="padding-block: 48px; align-items: center; justify-content: space-between; gap: 24px;">
      <h2 class="pixel" style="flex: 1 1 520px; font-size: 34px;">{g.cta?.[lang] ?? t(lang, 'game.cta')}</h2>
      <a class="btn btn--dark btn--big" href="#avvisami">{t(lang, 'card.notify')}</a>
    </div>
  </section>
</Base>
)}

{r && <CircoloPage lang={lang} r={r} altPath={alt} />}
