{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deve coincidere con il nome del Worker su Cloudflare
  "name": "dreamspace-sito",
  "compatibility_date": "2026-11-17",
  // Anteprima privata con link d'invito: vedi worker/index.js
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
