{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deve coincidere con il nome del Worker su Cloudflare
  "name": "dreamspace-sito",
  "compatibility_date": "2026-11-17",
  // Anteprima privata con link d'invito: vedi worker/index.js
  "main": "./worker/index.js",
  // Non cancellare le variabili impostate a mano sul pannello di Cloudflare
  "keep_vars": true,
  // Database delle iscrizioni alla lista d'attesa. Cloudflare lo crea da solo al primo deploy.
  // Si consulta da dash.cloudflare.com → Storage & Databases → D1 → dreamspace-sito-db.
  "d1_databases": [{ "binding": "DB", "database_name": "dreamspace-sito-db" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
